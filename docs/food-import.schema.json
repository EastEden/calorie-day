{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calorie-day.local/schemas/food-import-v1.json",
  "title": "每日热量食物库导入格式",
  "description": "第一版食物库 JSON 导入格式。营养数据按每 100g 保存，servings 为可选常用份量。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "foods"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "格式版本，当前仅支持 1"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "导出时间，可选"
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/food"
      }
    }
  },
  "definitions": {
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kcal", "proteinG", "carbsG", "fatG"],
      "properties": {
        "kcal": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "proteinG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "carbsG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "fatG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "grams"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "例如：个、块、杯、汤匙"
        },
        "grams": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      }
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "basis", "nutritionPer100g"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "可选。不填时导入时自动生成；有值时可与现有食物按 ID 匹配。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "protein",
            "staple",
            "egg_dairy_soy",
            "vegetable",
            "fruit",
            "fat_nut_condiment",
            "other"
          ]
        },
        "basis": {
          "type": "string",
          "enum": ["raw", "dry", "as_sold"],
          "description": "raw=生重，dry=干重，as_sold=商品状态/可食部"
        },
        "nutritionPer100g": {
          "$ref": "#/definitions/nutrition"
        },
        "servings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/serving"
          }
        }
      }
    }
  }
}
