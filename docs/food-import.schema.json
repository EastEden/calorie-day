{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calorie-day.local/schemas/food-import-v1.json",
  "title": "每日热量食物库导入格式 v1",
  "description": "食物库 JSON 导入格式 v1。营养数据按每 100g 保存，食物名称使用语言代码对象，且必须至少包含 zh-CN。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "foods"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "格式版本，当前导出为 1"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "description": "导出时间，可选"
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/food"
      }
    }
  },
  "definitions": {
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kcal", "proteinG", "carbsG", "fatG"],
      "properties": {
        "kcal": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "proteinG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "carbsG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "fatG": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "names": {
      "type": "object",
      "description": "语言代码 -> 食物名称。zh-CN 必需，可附加其他语言版本。",
      "required": ["zh-CN"],
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "简体中文名称，必需，作为兜底显示文本。"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "grams"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "例如：个、块、杯、汤匙"
        },
        "grams": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalGrams", "portionGrams"],
      "properties": {
        "totalGrams": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "portionGrams": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "sourceFoodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "disposedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "category", "basis", "nutritionPer100g"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "可选。不填时导入时自动生成；有值时可与现有食物按 ID 匹配。"
        },
        "names": {
          "$ref": "#/definitions/names"
        },
        "category": {
          "type": "string",
          "enum": [
            "protein",
            "staple",
            "egg_dairy_soy",
            "vegetable",
            "fruit",
            "fat_nut_condiment",
            "other"
          ]
        },
        "basis": {
          "type": "string",
          "enum": ["raw", "dry", "as_sold"],
          "description": "raw=生重，dry=干重，as_sold=商品状态/可食部"
        },
        "nutritionPer100g": {
          "$ref": "#/definitions/nutrition"
        },
        "servings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/serving"
          }
        },
        "batch": {
          "$ref": "#/definitions/batch"
        }
      }
    }
  }
}
