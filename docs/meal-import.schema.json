{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://calorie-day.local/schemas/meal-import-v1.json",
  "title": "每日热量饮食记录导入格式 v1",
  "description": "从其他 AI 工具导入单天/多天饮食记录的 JSON 格式 v1。营养按本次摄入总量填写。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "days"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/day"
      }
    }
  },
  "definitions": {
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kcal", "proteinG", "carbsG", "fatG"],
      "properties": {
        "kcal": { "type": "number", "minimum": 0, "maximum": 100000 },
        "proteinG": { "type": "number", "minimum": 0, "maximum": 10000 },
        "carbsG": { "type": "number", "minimum": 0, "maximum": 10000 },
        "fatG": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "amountGrams", "nutrition"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amountGrams": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "nutrition": { "$ref": "#/definitions/nutrition" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "meals"],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "meals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["breakfast", "lunch", "dinner", "snack"],
          "properties": {
            "breakfast": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/entry" } },
            "lunch": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/entry" } },
            "dinner": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/entry" } },
            "snack": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/entry" } }
          }
        }
      }
    }
  }
}
